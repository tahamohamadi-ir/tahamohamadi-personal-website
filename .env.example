# Local development defaults only. Do not use production credentials here.
POSTGRES_DB=taha_site
POSTGRES_USER=taha_site
POSTGRES_PASSWORD=taha_local_password
POSTGRES_PORT=5432
POSTGRES_VOLUME=taha_postgres_data

DB_HOST=localhost
DB_PORT=5432
DB_NAME=taha_site
DB_USERNAME=taha_site
DB_PASSWORD=taha_local_password

TAHA_BACKEND_PORT=8080

# CMS rollout flags. Spring Boot maps these to taha.features.*-enabled.
# They are configuration values only until the corresponding capability consumes them.
TAHA_FEATURES_HOME_V2_ENABLED=true
TAHA_FEATURES_COMPOSER_CANVAS_ENABLED=true
TAHA_FEATURES_ARTICLE_BLOCK_EDITOR_ENABLED=true
TAHA_FEATURES_PORTFOLIO_CASE_STUDY_ENABLED=true
TAHA_FEATURES_WORKFLOW_SCHEDULING_ENABLED=true
